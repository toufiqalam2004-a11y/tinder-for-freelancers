# ===================================================================
# Tinder for Freelancers — Environment Configuration Reference (.env)
# ===================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real secrets to version control.

# -------------------------------------------------------------------
# 1. CORE APPLICATION SERVER CONFIGURATION
# -------------------------------------------------------------------
# Set to 'production' for live deployment; 'development' for local work
NODE_ENV=development

# Port on which the Express backend listens (default: 5000)
PORT=5000

# Administrator Master Secret Key (REQUIRED IN PRODUCTION)
# Must be set to a strong, high-entropy random string in production.
# Server startup will abort in production if this variable is missing or left as default.
ADMIN_SECRET_KEY=your_production_admin_secret_key_here

# -------------------------------------------------------------------
# 2. SUBDOMAIN ARCHITECTURE & CORS CONFIGURATION
# -------------------------------------------------------------------
# Primary Landing Website URL
FRONTEND_ORIGIN=https://yourdomain.com

# User App Subdomain URL
APP_URL=https://app.yourdomain.com

# Admin Panel Subdomain URL
ADMIN_URL=https://admin.yourdomain.com

# Backend API Origin
API_URL=https://api.yourdomain.com

# Optional: Comma-separated list of additional allowed origins for CORS
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,https://admin.yourdomain.com

# -------------------------------------------------------------------
# 3. FRONTEND CLIENT-SIDE API BASE URL
# -------------------------------------------------------------------
# Base path for frontend API requests:
# - For same-domain or reverse-proxy deployment: /api
# - For decoupled subdomain architecture: https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

# -------------------------------------------------------------------
# 4. DATABASE ENGINE & STORAGE PATH
# -------------------------------------------------------------------
# Path to directory where JSON database files (*.json) are stored.
# Default: ../data (root ./data)
DATA_DIR=./data

# IMPORTANT PERSISTENCE REQUIREMENT:
# The JSON database requires a PERSISTENT FILESYSTEM with read/write access.
# It must NOT be deployed to serverless/ephemeral platforms (e.g. AWS Lambda,
# Vercel Serverless Functions) where filesystem storage is destroyed on cold starts.
# Deploy on a persistent VPS, dedicated VM, or Docker container with a mounted volume.

# -------------------------------------------------------------------
# 5. AUTHENTICATION & DEMO SWITCHES
# -------------------------------------------------------------------
# Set to 'false' in production to disable development OTP (1234) and enforce randomized codes
ENABLE_DEMO_OTP=true

# Set to 'false' in production when live transactional outreach providers are connected
ENABLE_DEMO_OUTREACH=true

# -------------------------------------------------------------------
# 6. FUTURE INTEGRATIONS (OPTIONAL - CONNECTED LATER)
# -------------------------------------------------------------------
# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:TinderForFreelancers:v6.0.0 (by /u/your_username)

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=

# X (Twitter) API v2 (https://developer.twitter.com)
X_BEARER_TOKEN=

# AI Completion Provider (Google Gemini API / OpenAI compatible)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Optional Email Notification Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
