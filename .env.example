# ===================================================================
# Tinder for Freelancers — Environment Configuration Example (.env)
# ===================================================================
# Copy this file to .env and configure your real credentials.
# NEVER commit .env to version control.

# Application Server Configuration
PORT=5000
NODE_ENV=development

# Domain & CORS Origins (Required for Production)
FRONTEND_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Client-Side API Base (Empty or /api for same-domain reverse proxy, or full backend URL)
VITE_API_BASE_URL=/api

# Authentication Switch (Set to 'false' in production to disable demo OTP 123456)
ENABLE_DEMO_OTP=true

# 1. Reddit API Credentials (https://www.reddit.com/prefs/apps)
# Create a 'script' type app (Optional in Demo Mode)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:TinderForFreelancers:v6.0.0 (by /u/your_username)

# 2. YouTube Data API v3 (Google Cloud Console)
# Enable YouTube Data API v3 and generate an API key (Optional in Demo Mode)
YOUTUBE_API_KEY=

# 3. X (Twitter) API v2 (https://developer.twitter.com)
# Generate a Bearer Token with read access (Optional in Demo Mode)
X_BEARER_TOKEN=

# 4. AI Provider (Google Gemini API / OpenAI compatible)
# Get key from https://aistudio.google.com or provider (Optional in Demo Mode)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# 5. Database Storage Path (Server-side JSON database engine)
DATABASE_URL=./server/data/

# 6. Optional Email Notification Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
